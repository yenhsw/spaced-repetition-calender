# Copy to .env for local `supabase functions serve` only.
# Production: set these in Supabase Dashboard → Edge Functions → Secrets.

RESEND_API_KEY=re_your_key_here
EMAIL_FROM=Reminders <onboarding@resend.dev>
CRON_SECRET=your-random-cron-secret
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Must be mailto: or https: URL (plain email is auto-fixed in code)
VAPID_SUBJECT=mailto:you@example.com
